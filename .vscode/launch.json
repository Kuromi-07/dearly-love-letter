{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Next.js: dev",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Ready in .*\\s+(https?://\\S+)",
                "uriFormat": "%s"
            },
            "skipFiles": ["<node_internals>/**"]
        }
    ]
}